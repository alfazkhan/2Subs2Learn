{
  "name": "2Subs2Learn",
  "description": "Watch your favorite content with Multiple subtitles",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test:e2e": "node ./e2e/run.mjs",
    "test:e2e:brave:youtube": "node ./e2e/run.mjs --browser=chromium --site=youtube",
    "test:e2e:brave:zdf": "node ./e2e/run.mjs --browser=chromium --site=zdf",
    "test:e2e:firefox:youtube": "node ./e2e/run.mjs --browser=firefox --site=youtube",
    "test:e2e:firefox:zdf": "node ./e2e/run.mjs --browser=firefox --site=zdf",
    "test:firefox": "node ./e2e/run.mjs --browser=firefox",
    "test:brave": "node ./e2e/run.mjs --browser=chromium"
  },
  "dependencies": {
    "@testing-library/dom": "^10.1.0",
    "@testing-library/react": "^16.3.3",
    "@xenova/transformers": "^2.17.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "selenium-webdriver": "^4.51.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.1.5",
    "autoprefixer": "^10.6.1",
    "daisyui": "^5.7.46",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.7",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.3"
  }
}
